---
// import "../styles/index.css"
import "../sass/style.scss"
import Header from "../components/header.astro"
import Footer from "../components/footer.astro"

const { uid, pageType } = Astro.props
// console.log(uid)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- 
      preloadでフォントを早い段階で読み込むようにする 
      → この記述だけでは読み込めない。cssで読み込む
    -->
    <!-- <link
      rel="preload"
      href="/fonts/satoshi/Satoshi-Variable.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    /> -->

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

    <link rel="icon" type="image/svg+xml" href="https://tympanus.net/favicon/favicon.svg" />
    <link rel="shortcut icon" href="" />
    <meta name="generator" content={Astro.generator} />

    <!-- <link rel="stylesheet" href="https://use.typekit.net/gwa0xin.css" /> -->
    <title>WebGL Pixel Effect on Scroll with GSAP, Three.js and Astro</title>
  </head>
  <body data-barba="wrapper">
    <div class="global-container" id="js-global-container">
      <!--
        data-barba="container"
        → ここを削除 → 遷移先のページのcontainerを差し込む
      -->
      <Header />

      <!-- ✅ ローディングアニメーションのdistort。loading - post - process  -->
      <!-- <div class="load-pp" data-webgl="distortion-text"></div> -->

      <div id="app" data-barba="container" data-barba-namespace={uid}>
        <div id="smooth-content" data-page-type={pageType}>
          <slot />
        </div>
      </div>

      <Footer />
    </div>

    <canvas class="l-canvas p-canvas" id="js-canvas"></canvas>
    <script src="../app/main.js"></script>
  </body>
</html>
