---

// ✅ TODO
// OGP画像 → 絶対URLにする


// import "../styles/index.css"
import "../sass/style.scss"
import Header from "../components/header.astro"
import Footer from "../components/footer.astro"

const { 
  uid,
  pageType,
  title,
  description,
  image,
  type
} = Astro.props
// console.log(uid, pageType);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- 
      preloadでフォントを早い段階で読み込むようにする 
      → この記述だけでは読み込めない。cssで読み込む
    -->
    <!-- <link
      rel="preload"
      href="/fonts/satoshi/Satoshi-Variable.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    /> -->

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

    <link rel="canonical" href={ Astro.url }>
    <!-- このHTMLを何で生成したか。このページを生成したAstroの情報 -->
    <meta name="generator" content={Astro.generator} />

    <title>{ title }</title>
    <meta name="description" content={ description }>
    <!-- OGP -->
    <meta property="og:title" content={ title } />
    <meta property="og:site_name" content="yのポートフォリオサイト。サイト全体の名前" />
    <meta property="og:description" content={ description } />
    <meta property="og:type" content={ type } />
    <!-- Astro.url → 現在表示しているURL -->
    <meta property="og:url" content={ Astro.url } /> 
    <meta property="og:image" content={ image } />
    <meta property="og:image:alt" content={ title } />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- favicon.ico 16*16、32*32、48*48 -->
    <link rel="icon" href="/favicon.ico" />
    <!-- タッチアイコン 180*180のpng -->
    <link rel="apple-touch-icon" sizes="180x180" href="">
    <!-- Android 192*192のpng-->
    <link rel="icon" type="image/png" sizes="192x192" href="">
    <!-- クローラー -->
    <!-- <meta name="robots" content="noindex,nofollow"> -->


  </head>
  <body data-barba="wrapper">
    <div class="global-container" id="js-global-container">
      <!--
        data-barba="container"
        → ここを削除 → 遷移先のページのcontainerを差し込む
      -->
      <Header />

      <!-- ✅ ローディングアニメーションのdistort。loading - post - process  -->
      <!-- <div class="load-pp" data-webgl="distortion-text"></div> -->

      <div id="app" data-barba="container" data-barba-namespace={uid}>
        <div id="smooth-content" data-page-type={pageType}>
          <slot />
        </div>
      </div>

      <Footer />
    </div>

    <canvas class="l-canvas p-canvas" id="js-canvas"></canvas>
    <script src="../app/main.js"></script>
  </body>
</html>
