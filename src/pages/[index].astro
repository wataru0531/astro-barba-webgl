---
import Layout from '../layouts/Layout.astro';
import medias from '../data.json';

export const getStaticPaths = async () => {
  return medias.map((media) => {
    return {
      params: { index: media.index.toString() },
      props: {
        media,
      },
    };
  });
};

// layoutにmetaタグ情報、OGP情報を渡して動的にする
const { media } = Astro.props;

---

<Layout 
  uid={`detail-${media.index}`} 
  pageType="detail"
  title={`${media.name} | yのポートフォリオサイト`}
  description={`${media.name}の詳細ページ`}
  imagePath={`${media.url}`}
  type="article"
>
  <div class="details">
    <!-- Meshのテスト表示テスト -->
    <div 
      class="vision__fallback"
      data-webgl="gray-pic"
      data-tex-1="/img/slider/slider_2.jpg"
    ></div>
    <div 
      class="vision__fallback"
      data-webgl="gray-pic"
      data-tex-1="/img/slider/slider_3.jpg"
    ></div>


    <div data-text-animation class="details-data">
      <a href="/">← Index</a>
      <p>{media.data}</p>
      <p>{media.location}</p>
      <p>{media.name}</p>
    </div>
    <div class="details-container">
      <img
        data-detail-media
        loading="eager"
        src={media.url}
        alt={`Image ${media.index}`}
      />
    </div>
  </div>
</Layout>
